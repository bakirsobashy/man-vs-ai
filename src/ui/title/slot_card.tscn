[gd_scene format=3]

[ext_resource type="Script" path="res://src/ui/title/slot_card.gd" id="1_card"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
bg_color = Color(0.08, 0.09, 0.12, 0.96)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.45, 0.55, 0.7, 1)
content_margin_left = 10.0
content_margin_top = 10.0
content_margin_right = 10.0
content_margin_bottom = 10.0

[node name="SlotCard" type="PanelContainer"]
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")
script = ExtResource("1_card")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2

[node name="TitleLabel" type="Label" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "SLOT 1"

[node name="InfoLabel" type="Label" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Empty"
autowrap_mode = 3

[node name="Buttons" type="HBoxContainer" parent="VBox"]
layout_mode = 2

[node name="PlayButton" type="Button" parent="VBox/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 34)
layout_mode = 2
size_flags_horizontal = 3
text = "New story"

[node name="DeleteButton" type="Button" parent="VBox/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 34)
layout_mode = 2
text = "Delete"

[node name="ConfirmTimer" type="Timer" parent="."]
unique_name_in_owner = true
wait_time = 3.0
one_shot = true

[connection signal="pressed" from="VBox/Buttons/PlayButton" to="." method="_on_play_button_pressed"]
[connection signal="pressed" from="VBox/Buttons/DeleteButton" to="." method="_on_delete_button_pressed"]
[connection signal="timeout" from="ConfirmTimer" to="." method="_on_confirm_timer_timeout"]
