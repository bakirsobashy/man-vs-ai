[ext_resource type="Texture2D" path="res://assets/art/placeholder/landing_circle.svg" id="3_circle"]
[ext_resource type="PackedScene" path="res://src/weapons/explosion/explosion.tscn" id="4_explosion"]

[node name="Grenade" type="Node2D"]
