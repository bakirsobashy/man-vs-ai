[gd_scene format=3]

[ext_resource type="Script" path="res://src/weapons/fire/burning_ground.gd" id="1_fire"]
[ext_resource type="Texture2D" path="res://assets/art/placeholder/burning_ground.svg" id="2_sprite"]

[sub_resource type="CircleShape2D" id="CircleShape2D_fire"]
radius = 14.0

[sub_resource type="Animation" id="Animation_flicker"]
length = 0.4
loop_mode = 1
tracks/0/type = "value"
tracks/0/imported = false
tracks/0/enabled = true
tracks/0/path = NodePath("Sprite:modulate")
tracks/0/interp = 1
tracks/0/loop_wrap = true
tracks/0/keys = {
"times": PackedFloat32Array(0, 0.2, 0.4),
"transitions": PackedFloat32Array(1, 1, 1),
"update": 0,
"values": [Color(1, 1, 1, 0.8), Color(1, 0.85, 0.7, 1), Color(1, 1, 1, 0.8)]
}

[sub_resource type="AnimationLibrary" id="AnimationLibrary_fire"]
_data = {
&"flicker": SubResource("Animation_flicker")
}

[node name="BurningGround" type="Area2D"]
collision_layer = 0
collision_mask = 8
script = ExtResource("1_fire")
damage = 3

[node name="Shape" type="CollisionShape2D" parent="."]
shape = SubResource("CircleShape2D_fire")

[node name="Sprite" type="Sprite2D" parent="."]
texture = ExtResource("2_sprite")

[node name="BurnTimer" type="Timer" parent="."]
wait_time = 0.5
autostart = true

[node name="LifeTimer" type="Timer" parent="."]
wait_time = 3.0
one_shot = true
autostart = true

[node name="FlameAnimation" type="AnimationPlayer" parent="."]
libraries/ = SubResource("AnimationLibrary_fire")
autoplay = &"flicker"

[connection signal="timeout" from="BurnTimer" to="." method="_on_burn_timer_timeout"]
[connection signal="timeout" from="LifeTimer" to="." method="_on_life_timer_timeout"]
