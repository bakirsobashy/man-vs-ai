tuning = ExtResource("10_tuning")

[node name="TouchController" type="Node" parent="." node_paths=PackedStringArray("hud")]
script = ExtResource("11_touch")
tuning = ExtResource("10_tuning")
hud = NodePath("../HUD")

[node name="HUD" parent="." instance=ExtResource("12_hud")]

[node name="WaveSpawner" type="Node" parent="." node_paths=PackedStringArray("next_wave_timer")]
script = ExtResource("13_wave_spawner")
settings = ExtResource("14_waves")
next_wave_timer = NodePath("NextWaveTimer")

[node name="NextWaveTimer" type="Timer" parent="WaveSpawner"]
wait_time = 1.2
one_shot = true

[node name="RoomRewardDrops" type="Node" parent="."]
script = ExtResource("15_drops")
crypto_min = 3
crypto_max = 6
crypto_scene = ExtResource("16_crypto")
extras = Array[ExtResource("17_drop_chance")]([SubResource("Resource_reward_heart"), SubResource("Resource_reward_ammo"), SubResource("Resource_reward_armor")])
scatter = 16.0

[node name="ArenaRewardDrops" type="Node" parent="."]
script = ExtResource("15_drops")
ram_mb = 48
ram_scene = ExtResource("21_ram")
crypto_min = 30
crypto_max = 30
crypto_scene = ExtResource("16_crypto")
scatter = 16.0

[node name="LevelDirector" type="Node" parent="." node_paths=PackedStringArray("room_holder", "player", "camera", "wave_spawner", "room_reward", "arena_reward", "transition")]
script = ExtResource("1_director")
config = ExtResource("2_config")
room_holder = NodePath("../RoomHolder")
player = NodePath("../Player")
camera = NodePath("../Camera")
wave_spawner = NodePath("../WaveSpawner")
room_reward = NodePath("../RoomRewardDrops")
arena_reward = NodePath("../ArenaRewardDrops")
chest_scene = ExtResource("22_chest")
transition = NodePath("../Transition/TransitionAnimation")

[node name="Transition" type="CanvasLayer" parent="."]
layer = 10

[node name="Fade" type="ColorRect" parent="Transition"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0, 0, 0, 0)

[node name="TransitionAnimation" type="AnimationPlayer" parent="Transition"]
libraries/ = SubResource("AnimationLibrary_transition")

[connection signal="touch_started" from="TouchController" to="Player" method="_on_touch_started"]
[connection signal="rolled" from="TouchController" to="Player" method="_on_touch_rolled"]
[connection signal="lifted" from="TouchController" to="Player" method="_on_touch_lifted"]
[connection signal="special_requested" from="TouchController" to="Player" method="_on_touch_special_requested"]
[connection signal="timeout" from="WaveSpawner/NextWaveTimer" to="WaveSpawner" method="_on_next_wave_timer_timeout"]
[connection signal="room_cleared" from="WaveSpawner" to="LevelDirector" method="_on_wave_spawner_room_cleared"]
