[gd_scene format=3]

[ext_resource type="Script" path="res://src/hub/cosmetic_row.gd" id="1_row"]

[node name="CosmeticRow" type="HBoxContainer"]
script = ExtResource("1_row")

[node name="Text" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 0

[node name="NameLabel" type="Label" parent="Text"]
unique_name_in_owner = true
layout_mode = 2
text = "Cosmetic"

[node name="DetailLabel" type="Label" parent="Text"]
unique_name_in_owner = true
modulate = Color(1, 1, 1, 0.6)
layout_mode = 2
theme_override_font_sizes/font_size = 10
autowrap_mode = 3
text = "..."

[node name="ActionButton" type="Button" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(88, 32)
layout_mode = 2
text = "Equip"

[connection signal="pressed" from="ActionButton" to="." method="_on_action_button_pressed"]
