[node name="Instructions" type="PanelContainer" parent="TutorialUI"]
anchors_preset = 10
anchor_right = 1.0
offset_left = 12.0
offset_top = 90.0
offset_right = -12.0
offset_bottom = 170.0
grow_horizontal = 2
mouse_filter = 2
theme = SubResource("Theme_ui")
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="VBox" type="VBoxContainer" parent="TutorialUI/Instructions"]
layout_mode = 2
mouse_filter = 2

[node name="StepLabel" type="Label" parent="TutorialUI/Instructions/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.43, 0.83, 0.66, 1)
text = "REHAB 1/4"

[node name="Instruction" type="Label" parent="TutorialUI/Instructions/VBox"]
layout_mode = 2
text = "..."
autowrap_mode = 3

[node name="Skip" type="Button" parent="TutorialUI"]
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -100.0
offset_top = 52.0
offset_right = -8.0
offset_bottom = 84.0
grow_horizontal = 0
theme = SubResource("Theme_ui")
text = "tutorial.skip"

[node name="TutorialDirector" type="Node" parent="." node_paths=PackedStringArray("steps_root", "step_label", "instruction_label", "step_timer")]
script = ExtResource("1_director")
steps_root = NodePath("../Steps")
step_label = NodePath("../TutorialUI/Instructions/VBox/StepLabel")
instruction_label = NodePath("../TutorialUI/Instructions/VBox/Instruction")
step_timer = NodePath("StepTimer")

[node name="StepTimer" type="Timer" parent="TutorialDirector"]
wait_time = 1.0
one_shot = true

[node name="MusicCue" type="Node" parent="."]
script = ExtResource("91_music_cue")
stream = ExtResource("92_lab_theme")

[node name="TextScaler" type="Node" parent="."]
script = ExtResource("96_text_scaler")
theme = SubResource("Theme_ui")
base_size = 12

[connection signal="touch_started" from="TouchController" to="Player" method="_on_touch_started"]
[connection signal="rolled" from="TouchController" to="Player" method="_on_touch_rolled"]
[connection signal="lifted" from="TouchController" to="Player" method="_on_touch_lifted"]
[connection signal="special_requested" from="TouchController" to="Player" method="_on_touch_special_requested"]
[connection signal="timeout" from="TutorialDirector/StepTimer" to="TutorialDirector" method="_on_step_timer_timeout"]
[connection signal="pressed" from="TutorialUI/Skip" to="TutorialDirector" method="_on_skip_pressed"]
