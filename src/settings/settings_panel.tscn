[gd_scene format=3]

[ext_resource type="Script" path="res://src/settings/settings_panel.gd" id="1_panel"]
[ext_resource type="Script" path="res://src/components/text_scaler.gd" id="2_text_scaler"]

[sub_resource type="Theme" id="Theme_settings"]
default_font_size = 12

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_settings"]
bg_color = Color(0.06, 0.07, 0.09, 0.97)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.35, 0.55, 0.7, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6
content_margin_left = 12.0
content_margin_top = 10.0
content_margin_right = 12.0
content_margin_bottom = 10.0

[node name="SettingsPanel" type="PanelContainer"]
visible = false
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 14.0
offset_top = 40.0
offset_right = -14.0
offset_bottom = -20.0
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_settings")
theme_override_styles/panel = SubResource("StyleBoxFlat_settings")
script = ExtResource("1_panel")

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Layout"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
horizontal_alignment = 1
text = "SETTINGS"

[node name="Scroll" type="ScrollContainer" parent="Layout"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="List" type="VBoxContainer" parent="Layout/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="AudioHeader" type="Label" parent="Layout/Scroll/List"]
layout_mode = 2
modulate = Color(0.6, 0.85, 1, 1)
text = "AUDIO"

[node name="MusicCaption" type="Label" parent="Layout/Scroll/List"]
layout_mode = 2
text = "Music"

[node name="MusicSlider" type="HSlider" parent="Layout/Scroll/List"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 24)
layout_mode = 2
min_value = 0
max_value = 1
step = 0.05

[node name="SfxCaption" type="Label" parent="Layout/Scroll/List"]
layout_mode = 2
text = "Sound effects"

[node name="SfxSlider" type="HSlider" parent="Layout/Scroll/List"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 24)
layout_mode = 2
min_value = 0
max_value = 1
step = 0.05

[node name="ControlsHeader" type="Label" parent="Layout/Scroll/List"]
layout_mode = 2
modulate = Color(0.6, 0.85, 1, 1)
text = "CONTROLS"

[node name="JoystickCheck" type="CheckButton" parent="Layout/Scroll/List"]
unique_name_in_owner = true
layout_mode = 2
text = "Show the joystick"

[node name="StickSizeRow" type="HBoxContainer" parent="Layout/Scroll/List"]
layout_mode = 2

[node name="Caption" type="Label" parent="Layout/Scroll/List/StickSizeRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "Joystick size"

[node name="StickSizeOption" type="OptionButton" parent="Layout/Scroll/List/StickSizeRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(130, 30)
layout_mode = 2

[node name="StickOpacityCaption" type="Label" parent="Layout/Scroll/List"]
layout_mode = 2
text = "Joystick opacity"

[node name="StickOpacitySlider" type="HSlider" parent="Layout/Scroll/List"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 24)
layout_mode = 2
min_value = 0.2
max_value = 1
step = 0.05

[node name="SwipeRow" type="HBoxContainer" parent="Layout/Scroll/List"]
layout_mode = 2

[node name="Caption" type="Label" parent="Layout/Scroll/List/SwipeRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "Roll swipe sensitivity"

[node name="SwipeOption" type="OptionButton" parent="Layout/Scroll/List/SwipeRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(130, 30)
layout_mode = 2

[node name="DoubleTapCaption" type="Label" parent="Layout/Scroll/List"]
layout_mode = 2
text = "Double-tap window (EMP)"

[node name="DoubleTapSlider" type="HSlider" parent="Layout/Scroll/List"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 24)
layout_mode = 2
min_value = 0.2
max_value = 0.5
step = 0.05

[node name="ReticleCheck" type="CheckButton" parent="Layout/Scroll/List"]
unique_name_in_owner = true
layout_mode = 2
text = "Aim reticle"

[node name="FeedbackHeader" type="Label" parent="Layout/Scroll/List"]
layout_mode = 2
modulate = Color(0.6, 0.85, 1, 1)
text = "FEEDBACK"

[node name="HapticsCheck" type="CheckButton" parent="Layout/Scroll/List"]
unique_name_in_owner = true
layout_mode = 2
text = "Vibration"

[node name="ShakeCheck" type="CheckButton" parent="Layout/Scroll/List"]
unique_name_in_owner = true
layout_mode = 2
text = "Screen shake"

[node name="FlashingCheck" type="CheckButton" parent="Layout/Scroll/List"]
unique_name_in_owner = true
layout_mode = 2
text = "Reduced flashing"

[node name="DisplayHeader" type="Label" parent="Layout/Scroll/List"]
layout_mode = 2
modulate = Color(0.6, 0.85, 1, 1)
text = "DISPLAY"

[node name="PaletteRow" type="HBoxContainer" parent="Layout/Scroll/List"]
layout_mode = 2

[node name="Caption" type="Label" parent="Layout/Scroll/List/PaletteRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "Bullet colors"

[node name="PaletteOption" type="OptionButton" parent="Layout/Scroll/List/PaletteRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(130, 30)
layout_mode = 2

[node name="TextSizeRow" type="HBoxContainer" parent="Layout/Scroll/List"]
layout_mode = 2

[node name="Caption" type="Label" parent="Layout/Scroll/List/TextSizeRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "Text size"

[node name="TextSizeOption" type="OptionButton" parent="Layout/Scroll/List/TextSizeRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(130, 30)
layout_mode = 2

[node name="FpsRow" type="HBoxContainer" parent="Layout/Scroll/List"]
layout_mode = 2

[node name="Caption" type="Label" parent="Layout/Scroll/List/FpsRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "Frame rate"

[node name="FpsOption" type="OptionButton" parent="Layout/Scroll/List/FpsRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(130, 30)
layout_mode = 2

[node name="LanguageRow" type="HBoxContainer" parent="Layout/Scroll/List"]
layout_mode = 2

[node name="Caption" type="Label" parent="Layout/Scroll/List/LanguageRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "Language"

[node name="LanguageOption" type="OptionButton" parent="Layout/Scroll/List/LanguageRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(130, 30)
layout_mode = 2

[node name="PrivacyButton" type="Button" parent="Layout"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(0, 30)
layout_mode = 2
text = "Privacy options (ads)"

[node name="CloseButton" type="Button" parent="Layout"]
custom_minimum_size = Vector2(0, 34)
layout_mode = 2
text = "Close"

[node name="TextScaler" type="Node" parent="."]
script = ExtResource("2_text_scaler")
theme = SubResource("Theme_settings")
base_size = 12

[connection signal="value_changed" from="Layout/Scroll/List/MusicSlider" to="." method="_on_music_slider_value_changed"]
[connection signal="value_changed" from="Layout/Scroll/List/SfxSlider" to="." method="_on_sfx_slider_value_changed"]
[connection signal="value_changed" from="Layout/Scroll/List/StickOpacitySlider" to="." method="_on_stick_opacity_slider_value_changed"]
[connection signal="value_changed" from="Layout/Scroll/List/DoubleTapSlider" to="." method="_on_double_tap_slider_value_changed"]
[connection signal="toggled" from="Layout/Scroll/List/JoystickCheck" to="." method="_on_joystick_check_toggled"]
[connection signal="toggled" from="Layout/Scroll/List/ReticleCheck" to="." method="_on_reticle_check_toggled"]
[connection signal="toggled" from="Layout/Scroll/List/HapticsCheck" to="." method="_on_haptics_check_toggled"]
[connection signal="toggled" from="Layout/Scroll/List/ShakeCheck" to="." method="_on_shake_check_toggled"]
[connection signal="toggled" from="Layout/Scroll/List/FlashingCheck" to="." method="_on_flashing_check_toggled"]
[connection signal="item_selected" from="Layout/Scroll/List/StickSizeRow/StickSizeOption" to="." method="_on_stick_size_option_item_selected"]
[connection signal="item_selected" from="Layout/Scroll/List/SwipeRow/SwipeOption" to="." method="_on_swipe_option_item_selected"]
[connection signal="item_selected" from="Layout/Scroll/List/PaletteRow/PaletteOption" to="." method="_on_palette_option_item_selected"]
[connection signal="item_selected" from="Layout/Scroll/List/TextSizeRow/TextSizeOption" to="." method="_on_text_size_option_item_selected"]
[connection signal="item_selected" from="Layout/Scroll/List/FpsRow/FpsOption" to="." method="_on_fps_option_item_selected"]
[connection signal="item_selected" from="Layout/Scroll/List/LanguageRow/LanguageOption" to="." method="_on_language_option_item_selected"]
[connection signal="pressed" from="Layout/PrivacyButton" to="." method="_on_privacy_button_pressed"]
[connection signal="pressed" from="Layout/CloseButton" to="." method="_on_close_button_pressed"]
