[gd_resource type="Resource" script_class="Conversation" format=3]

[ext_resource type="Script" path="res://src/ui/dialogue/conversation.gd" id="1_conversation"]
[ext_resource type="Script" path="res://src/ui/dialogue/dialogue_line.gd" id="2_line"]

[sub_resource type="Resource" id="Resource_line0"]
script = ExtResource("2_line")
speaker = "Vorn"
text = "Glitch. The one who faked the police call. Nobody came for your family because of that thing."

[sub_resource type="Resource" id="Resource_line1"]
script = ExtResource("2_line")
speaker = "Kade"
text = "It came apart like a cheap sign."

[sub_resource type="Resource" id="Resource_line2"]
script = ExtResource("2_line")
speaker = "Vorn"
text = "Holograms do. The Foundry builds the real bodies. That is where this goes next."

[sub_resource type="Resource" id="Resource_line3"]
script = ExtResource("2_line")
speaker = "Vorn"
text = "You're adapting faster than any patient I've had. I'm proud of that. Is that strange?"

[resource]
script = ExtResource("1_conversation")
lines = Array[ExtResource("2_line")]([SubResource("Resource_line0"), SubResource("Resource_line1"), SubResource("Resource_line2"), SubResource("Resource_line3")])
