[gd_resource type="Resource" script_class="Conversation" format=3]

[ext_resource type="Script" path="res://src/ui/dialogue/conversation.gd" id="1_conversation"]
[ext_resource type="Script" path="res://src/ui/dialogue/dialogue_line.gd" id="2_line"]

[sub_resource type="Resource" id="Resource_line0"]
script = ExtResource("2_line")
speaker = "Vorn"
text = "Welcome back to the land of the living, Sergeant. Mostly living."

[sub_resource type="Resource" id="Resource_line1"]
script = ExtResource("2_line")
speaker = "Kade"
text = "The machines that did this. Where are they?"

[sub_resource type="Resource" id="Resource_line2"]
script = ExtResource("2_line")
speaker = "Vorn"
text = "The Null Syndicate. Their first lieutenant, Scrapjaw, holds the Rustline. The elevator goes there."

[sub_resource type="Resource" id="Resource_line3"]
script = ExtResource("2_line")
speaker = "Vorn"
text = "When you're ready... I can make you better. The chair is right here."

[sub_resource type="Resource" id="Resource_line4"]
script = ExtResource("2_line")
speaker = "Patch"
text = "And when you're done being noble, I sell guns. Meat's honest, and so are my prices."

[resource]
script = ExtResource("1_conversation")
lines = Array[ExtResource("2_line")]([SubResource("Resource_line0"), SubResource("Resource_line1"), SubResource("Resource_line2"), SubResource("Resource_line3"), SubResource("Resource_line4")])
